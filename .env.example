# Copy this file to .env.local and fill in the real values.
# All variables are public (NEXT_PUBLIC_*) because this phase is frontend-only.

# Production URL — used for canonical URLs, sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://www.example.com

# WhatsApp number in international format, digits only (e.g. 8801XXXXXXXXX).
# Leave empty to open WhatsApp's contact picker with the prefilled message.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Contact details shown on the website (leave empty to show placeholders)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OFFICE_ADDRESS=

# Google Maps embed URL (Google Maps → Share → Embed a map → copy the src="..." value)
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Social links
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
